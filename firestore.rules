rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      // e-mail do usuário logado, sempre normalizado em minúsculas
      return request.auth.token.email.lower();
    }

    // Único ponto de verdade: um usuário só é admin se existir um
    // documento admins/{email-em-minusculo}. É este documento que
    // decide quem consegue acessar o painel administrativo.
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        (authEmail() == 'p.henriquepaulo37@gmail.com' || exists(/databases/$(database)/documents/admins/$(authEmail())));
    }

    // ---------- admins ----------
    // Coleção que funciona como "allowlist" de administradores.
    // Ninguém consegue se auto-promover: a escrita só é permitida
    // para quem já é admin (o primeiro admin é criado via script
    // com a Service Account, fora do alcance destas regras).
    match /admins/{email} {
      allow get: if isSignedIn() && authEmail() == email;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ---------- settings ----------
    // Dados públicos da loja (nome, logo, horário, taxa de entrega,
    // categorias, chave pix). Leitura livre para montar o cardápio,
    // escrita restrita ao admin.
    match /settings/{docId} {
      allow get: if true;
      allow write: if isAdmin();
    }

    // ---------- products ----------
    // Cardápio é público para leitura. Só admin cria/edita/exclui
    // produtos (inclui campo imageUrl apontando para o Storage).
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- users ----------
    // Perfil do cliente (nome, telefone, endereços). Cada cliente só
    // enxerga e edita o próprio documento; admin pode ler todos.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // ---------- orders ----------
    // Cliente autenticado (com conta Google ou como visitante, via login
    // anônimo) pode criar pedidos vinculados ao próprio uid e ler apenas os
    // seus. Alterar status, cancelar, excluir e ver todos os pedidos é
    // exclusivo do admin (painel financeiro) — com uma exceção: o próprio
    // cliente pode avaliar (nota + comentário) um pedido seu já entregue,
    // uma única vez, sem poder mexer em mais nenhum outro campo do pedido.
    //
    // Como pedir sem conta Google não exige mais nenhuma fricção humana
    // (um bot consegue um uid anônimo com uma chamada só), a validação de
    // formato abaixo é a única barreira contra pedidos forjados/spam —
    // por isso confere nome, telefone, tipo de entrega, forma de pagamento
    // e limites de tamanho, além do que já existia.
    match /orders/{orderId} {
      allow create: if isSignedIn() &&
        request.resource.data.customerUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() > 0 &&
        request.resource.data.customerName.size() <= 120 &&
        request.resource.data.customerPhone is string &&
        request.resource.data.customerPhone.size() > 0 &&
        request.resource.data.customerPhone.size() <= 30 &&
        request.resource.data.deliveryType in ['delivery', 'pickup'] &&
        request.resource.data.paymentMethod in ['pix', 'dinheiro', 'cartao'] &&
        request.resource.data.total is number &&
        request.resource.data.total > 0 &&
        request.resource.data.total <= 50000 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 60;

      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.customerUid == request.auth.uid);

      allow update: if isAdmin() ||
        (isSignedIn() &&
          resource.data.customerUid == request.auth.uid &&
          resource.data.status == 'delivered' &&
          !('rating' in resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rating", "feedback", "updatedAt"]) &&
          request.resource.data.rating is number &&
          request.resource.data.rating >= 1 && request.resource.data.rating <= 5);

      allow delete: if isAdmin();
    }

    // ---------- coupons ----------
    // Cupom de desconto (código, tipo, valor, pedido mínimo, limite de uso).
    // Leitura livre pra qualquer cliente conferir o código no checkout; só
    // admin cria, ativa/desativa ou remove. Uma exceção pontual: ao usar um
    // cupom, o cliente pode incrementar `usedCount` em exatamente 1 (nunca
    // mais que isso, nunca além do limite, nunca em cupom inativo) — é o
    // único jeito de controlar quantas vezes um cupom já foi usado sem um
    // backend próprio.
    function couponUsedCount(data) {
      return ('usedCount' in data) ? data.usedCount : 0;
    }

    match /coupons/{code} {
      allow read: if true;
      allow update: if isAdmin() ||
        (isSignedIn() &&
          resource.data.active == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["usedCount"]) &&
          request.resource.data.usedCount == couponUsedCount(resource.data) + 1 &&
          (!('maxUses' in resource.data) || resource.data.maxUses == 0 ||
            couponUsedCount(resource.data) < resource.data.maxUses));
      allow create, delete: if isAdmin();
    }

    // ---------- expenses ----------
    // Despesas usadas no controle financeiro (custos, compras, etc).
    // Totalmente restrito ao admin.
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    // ---------- notifications ----------
    // Avisos que aparecem no sininho do cliente (ex: mudança de status de
    // um pedido). Só o admin cria; o cliente dono só pode marcar como lida
    // (não pode criar, apagar, nem ler notificação de outra pessoa).
    match /notifications/{notificationId} {
      allow create: if isAdmin();
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.customerUid == request.auth.uid);
      allow update: if isAdmin() ||
        (isSignedIn() &&
          resource.data.customerUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]));
      allow delete: if isAdmin();
    }

    // Qualquer outra coleção não mapeada fica bloqueada por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
